# Copy to .env and fill in your own values. Never commit .env.

# Shared secret required on the inbound HubSpot workflow webhook.
WEBHOOK_SECRET=your_webhook_secret_here

# HubSpot private app access token (CRM read/write + Files scopes).
HUBSPOT_API_KEY=your_hubspot_private_app_token_here

# PandaDoc API key and the UUID of the referral form template.
PANDADOC_API_KEY=your_pandadoc_api_key_here
PANDADOC_TEMPLATE_ID=your_pandadoc_template_id_here

# Shared key configured on the PandaDoc webhook, used to verify signatures.
PANDADOC_WEBHOOK_SECRET=your_pandadoc_webhook_shared_key_here

# Mailboxes that receive a completed copy of each signed referral.
REFERRAL_TO_EMAIL=referral-copy@example.org
REFERRAL_NOTIFY_EMAIL=referrals@example.org

# Short organization name used in document titles, filenames and folders.
ORG_SHORT_NAME=Housing Org
